# Application
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# Security
JWT_ACCESS_SECRET=dart_jwt_access_super_secret_key_2026_mvp_change_in_production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=dart_jwt_refresh_super_secret_key_2026_mvp_change_in_production
JWT_REFRESH_EXPIRATION=7d

# Database (PostgreSQL)
DATABASE_URL="postgresql://dart_user:dart_password@localhost:5432/dart_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Payment Provider (Paystack / Mock)
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=sk_test_mock_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_mock_paystack_public_key
PAYSTACK_WEBHOOK_SECRET=mock_webhook_secret_key

# Notifications (Mock / Termii / Twilio / FCM)
NOTIFICATION_PROVIDER=mock
TERMII_API_KEY=mock_termii_api_key
FCM_SERVER_KEY=mock_fcm_key

# AWS / Object Storage (S3 / Mock)
STORAGE_PROVIDER=local
AWS_REGION=eu-west-1
AWS_S3_BUCKET=dart-uploads-dev
AWS_ACCESS_KEY_ID=mock_access_key
AWS_SECRET_ACCESS_KEY=mock_secret_key

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
